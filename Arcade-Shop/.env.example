# ---------------------------------------------------------------------------
# Arcade Vault — environment configuration
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# Secrets belong ONLY in env vars, never in code.
# ---------------------------------------------------------------------------

# --- Next / App ---
NEXT_PUBLIC_SITE_URL=https://arcadevault.gg
NEXTAUTH_URL=https://arcadevault.gg

# --- Auth (next-auth v4 + Clerk) ---
# Clerk publishable key (NEXT_PUBLIC_ — safe to expose to the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=clerk_pub_your-publishable-key
# Clerk secret key (server-only)
CLERK_SECRET_KEY=sk_test_your-secret-key
# next-auth secret — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# --- Database (Supabase OR MongoDB — pick one) ---
# Supabase:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-use-with-caution
# MongoDB:
# MONGODB_URI=mongodb://localhost:27017/arcade

# --- Payments (Stripe) ---
# STRIPE_SECRET_KEY=sk_test_your-stripe-key
# STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- Email (Resend) ---
# RESEND_API_KEY=re_1your-resend-key

# --- Storage (Cloudflare R2 / S3-compatible) ---
# R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# R2_ACCESS_KEY=your-access-key
# R2_SECRET_KEY=your-secret-key
# R2_BUCKET=arcade-assets

# --- Analytics (Mixpanel — optional) ---
# NEXT_PUBLIC_MIXPANEL_ID=your-mixpanel-id
